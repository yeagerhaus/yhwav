{
	"name": "rite",
	"main": "expo-router/entry",
	"version": "0.1",
	"scripts": {
		"start": "npx expo run:ios",
		"kill": "lsof -ti:8081 | xargs kill -9",
		"clean": "rm -rf node_modules && rm -rf ios/Pods ios/Podfile.lock && rm -rf .expo",
		"up": "bun update; bunx expo@latest install --check",
		"b": "eas build --profile development --platform ios",
		"b:test": "npx expo run:ios --configuration Release --device",
		"check:tsc": "tsc --project tsconfig.json --noEmit",
		"check:biome": "biome check --formatter-enabled=true --linter-enabled=true --vcs-enabled=true --write --unsafe .",
		"check:all": "bun check:tsc && bun check:biome",
		"prepare": "husky",
		"postinstall": "npx patch-package"
	},
	"dependencies": {
		"@expo/metro-runtime": "~58.0.17",
		"@react-native-community/slider": "5.2.1",
		"@react-navigation/native": "7.1.28",
		"@shopify/flash-list": "2.3.2",
		"expo": "^58.0.0",
		"expo-background-task": "~58.0.13",
		"expo-blur": "~58.0.6",
		"expo-constants": "~58.0.16",
		"expo-crypto": "~58.0.8",
		"expo-dev-client": "~58.0.21",
		"expo-device": "~58.0.5",
		"expo-file-system": "~58.0.14",
		"expo-font": "~58.0.12",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.8",
		"expo-image": "~58.0.18",
		"expo-linear-gradient": "~58.0.4",
		"expo-linking": "~58.0.17",
		"expo-network": "~58.0.5",
		"expo-notifications": "~58.1.9",
		"expo-router": "~58.0.32",
		"expo-secure-store": "~58.0.3",
		"expo-splash-screen": "~58.0.14",
		"expo-status-bar": "~58.0.5",
		"expo-symbols": "~58.0.5",
		"expo-system-ui": "~58.0.7",
		"expo-task-manager": "~58.0.14",
		"expo-web-browser": "~58.1.0",
		"fast-xml-parser": "^5.12.1",
		"react": "19.3.0",
		"react-native": "0.88.1",
		"react-native-carplay": "^2.4.1-beta.0",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-image-colors": "^2.6.1",
		"react-native-mmkv": "^4.3.2",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@biomejs/biome": "2.0.0",
		"@types/node": "^26.6.6",
		"@types/react": "~19.3.0",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"husky": "^9.1.7",
		"typescript": "~6.0.3"
	},
	"expo": {
		"doctor": {
			"appConfigFieldsNotSyncedCheck": {
				"enabled": false
			},
			"reactNativeDirectoryCheck": {
				"exclude": [
					"react-native-carplay",
					"yhwav-audio"
				]
			}
		}
	},
	"private": true
}
